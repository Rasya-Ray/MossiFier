# Copy this file to `.env` (BUKAN .env.local) dan isi nilai aslinya.
# Requirements: PostgreSQL >= 15 (Supabase).
#
# CATATAN: pakai Session pooler (port 5432). Transaction pooler (6543)
# tidak bisa dipakai untuk `prisma db init` / `prisma db update`.

# Prisma CLI / migrate
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase client (tanpa /rest/v1 di akhir)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECTREF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxx"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Auth: kunci HMAC untuk cookie sesi. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-string-acak-panjang"

DEVICE_ID="MOSS-ESP32-001"
APP_DATA_SOURCE="prisma"
